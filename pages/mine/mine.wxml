<view class="container">
  <!-- 用户信息 -->
  <view class="user-header">
    <image src="/images/avatar.png" class="avatar" />
    <view class="user-info">
      <text class="nickname">{{userInfo.nickName || '点击登录'}}</text>
      <text class="phone">{{userInfo.phone || '登录后查看'}}</text>
    </view>
  </view>

  <!-- 订单入口 -->
  <view class="order-tabs">
    <view class="tab-item" bindtap="goOrders" data-status="all">
      <text class="tab-num">{{orderCounts.all || 0}}</text>
      <text>全部</text>
    </view>
    <view class="tab-item" bindtap="goOrders" data-status="pending">
      <text class="tab-num">{{orderCounts.pending || 0}}</text>
      <text>待确认</text>
    </view>
    <view class="tab-item" bindtap="goOrders" data-status="doing">
      <text class="tab-num">{{orderCounts.doing || 0}}</text>
      <text>进行中</text>
    </view>
    <view class="tab-item" bindtap="goOrders" data-status="done">
      <text class="tab-num">{{orderCounts.done || 0}}</text>
      <text>已完成</text>
    </view>
  </view>

  <!-- 功能菜单 -->
  <view class="menu-group">
    <view class="menu-item" bindtap="goAddress">
      <text class="menu-icon">📍</text>
      <text class="menu-text">我的地址</text>
      <text class="menu-arrow">></text>
    </view>
    <view class="menu-item" bindtap="goFavorites">
      <text class="menu-icon">⭐</text>
      <text class="menu-text">我的收藏</text>
      <text class="menu-arrow">></text>
    </view>
    <view class="menu-item" bindtap="goCoupon">
      <text class="menu-icon">🎫</text>
      <text class="menu-text">优惠券</text>
      <text class="menu-arrow">></text>
    </view>
  </view>

  <view class="menu-group">
    <view class="menu-item" bindtap="goHelp">
      <text class="menu-icon">❓</text>
      <text class="menu-text">帮助中心</text>
      <text class="menu-arrow">></text>
    </view>
    <view class="menu-item" bindtap="goContact">
      <text class="menu-icon">📞</text>
      <text class="menu-text">联系客服</text>
      <text class="menu-arrow">></text>
    </view>
    <view class="menu-item" bindtap="goSettings">
      <text class="menu-icon">⚙️</text>
      <text class="menu-text">设置</text>
      <text class="menu-arrow">></text>
    </view>
  </view>
</view>
