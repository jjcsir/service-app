<!-- 个人中心 ── UI重构（含骑手入口） -->
<view class="page-mine">
  
  <!-- 头部：用户信息 -->
  <view class="profile-header">
    <view class="header-bg"></view>
    <view class="header-content">
      <image wx:if="{{isLoggedIn}}" src="{{userInfo.avatar || '/images/avatar.png'}}" class="avatar" mode="aspectFill" />
      <view wx:else class="avatar-placeholder">👤</view>
      
      <view class="user-meta">
        <text class="nickname">{{isLoggedIn ? userInfo.nickname : '未登录'}}</text>
        <text class="subtitle" wx:if="{{isLoggedIn}}">余额 ¥{{balance}}</text>
        <text class="subtitle" wx:else>登录后查看订单、优惠</text>
      </view>
    </view>
    
    <!-- 未登录时显示微信登录按钮 -->
    <button wx:if="{{!isLoggedIn}}" class="login-btn" open-type="getUserInfo" bindgetuserinfo="onWechatLogin">
      微信登录
    </button>
  </view>

  <!-- 骑手入口按钮（已登录可见） -->
  <view class="rider-entry card" wx:if="{{isLoggedIn}}" bindtap="goRiderRegister">
    <text class="rider-icon">🛵</text>
    <view class="rider-info">
      <text class="rider-title">成为骑手</text>
      <text class="rider-desc">注册成为配送骑手，赚取收入</text>
    </view>
    <text class="rider-arrow">›</text>
  </view>

  <!-- 商户工作台入口按钮（已登录可见） -->
  <view class="rider-entry card merchant-entry" wx:if="{{isLoggedIn}}" bindtap="goMerchant">
    <text class="rider-icon">🏢</text>
    <view class="rider-info">
      <text class="rider-title">商户工作台</text>
      <text class="rider-desc">管理店铺、查看订单与财务</text>
    </view>
    <text class="rider-arrow">›</text>
  </view>

  <!-- 模式切换 -->
  <view class="mode-switch card" wx:if="{{isLoggedIn}}">
    <view class="ms-left">
      <text class="ms-label">当前模式</text>
      <text class="ms-value">{{currentMode === 'user' ? '🛒 顾客端' : '🛵 骑手端'}}</text>
    </view>
    <button class="ms-toggle btn-outline" size="mini" bindtap="switchMode">切换</button>
  </view>

  <!-- 数据统计（顾客端） -->
  <view class="stats-section" wx:if="{{isLoggedIn && currentMode === 'user'}}">
    <view class="stat-card">
      <text class="stat-num">{{orderCounts.all}}</text>
      <text class="stat-label">全部订单</text>
    </view>
    <view class="stat-card">
      <text class="stat-num stat-warn">{{orderCounts.pending}}</text>
      <text class="stat-label">待确认</text>
    </view>
    <view class="stat-card">
      <text class="stat-num stat-doing">{{orderCounts.doing}}</text>
      <text class="stat-label">进行中</text>
    </view>
    <view class="stat-card">
      <text class="stat-num stat-done">{{orderCounts.done}}</text>
      <text class="stat-label">已完成</text>
    </view>
  </view>

  <!-- 快捷入口（资产） -->
  <view class="quick-section card" wx:if="{{isLoggedIn && currentMode === 'user'}}">
    <view class="section-header">
      <text class="section-title">我的资产</text>
    </view>
    <view class="quick-grid">
      <view class="quick-item" bindtap="goCoupon">
        <view class="qi-icon qi-coupon">🎫</view>
        <text class="qi-text">优惠券</text>
        <text class="qi-count">{{couponCount}}</text>
      </view>
      <view class="quick-item" bindtap="goAddress">
        <view class="qi-icon qi-address">📍</view>
        <text class="qi-text">收货地址</text>
      </view>
      <view class="quick-item" bindtap="goFavorites">
        <view class="qi-icon qi-fav">⭐</view>
        <text class="qi-text">我的收藏</text>
      </view>
      <view class="quick-item" bindtap="goWallet">
        <view class="qi-icon qi-wallet">💰</view>
        <text class="qi-text">钱包</text>
      </view>
    </view>
  </view>

  <!-- 功能菜单 -->
  <view class="menu-sections">
    <!-- 顾客端菜单 -->
    <block wx:if="{{currentMode === 'user'}}">
      <view class="menu-group card">
        <view class="menu-item" bindtap="goHelp">
          <text class="menu-icon">❓</text>
          <text class="menu-text">帮助中心</text>
          <text class="menu-arrow">›</text>
        </view>
        <view class="menu-item" bindtap="goContact">
          <text class="menu-icon">📞</text>
          <text class="menu-text">联系客服</text>
          <text class="menu-arrow">›</text>
        </view>
        <view class="menu-item" bindtap="goDistInfo">
          <text class="menu-icon">💰</text>
          <text class="menu-text">分销中心</text>
          <text class="menu-arrow">›</text>
        </view>
      </view>
    </block>

    <!-- 骑手端菜单 -->
    <block wx:if="{{currentMode === 'rider'}}">
      <view class="menu-group card">
        <view class="menu-item" bindtap="goRiderHome">
          <text class="menu-icon">🏠</text>
          <text class="menu-text">骑手工作台</text>
          <text class="menu-arrow">›</text>
        </view>
        <view class="menu-item" bindtap="goWithdraw">
          <text class="menu-icon">💸</text>
          <text class="menu-text">申请提现</text>
          <text class="menu-arrow">›</text>
        </view>
        <view class="menu-item" bindtap="goCert">
          <text class="menu-icon">🪪</text>
          <text class="menu-text">认证管理</text>
          <text class="menu-arrow">›</text>
        </view>
      </view>
    </block>

    <!-- 通用菜单 -->
    <view class="menu-group card">
      <view class="menu-item" bindtap="goSettings">
        <text class="menu-icon">⚙️</text>
        <text class="menu-text">设置</text>
        <text class="menu-arrow">›</text>
      </view>
      <view class="menu-item logout" wx:if="{{isLoggedIn}}" bindtap="onLogout">
        <text class="menu-icon">🚪</text>
        <text class="menu-text">退出登录</text>
        <text class="menu-arrow">›</text>
      </view>
    </view>
  </view>
</view>
