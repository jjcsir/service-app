/* ============================================
   个人中心 ── 完整UI设计（含骑手入口）
   ============================================ */

.page-mine { padding-bottom: 100rpx; }

/* ── 头部 ── */
.profile-header {
  background: linear-gradient(135deg, #FF6B35, #FF8F5E);
  padding: 60rpx 30rpx 40rpx;
  position: relative;
  overflow: hidden;
}

.header-bg {
  position: absolute;
  top: -60rpx; right: -40rpx;
  width: 200rpx; height: 200rpx;
  background: rgba(255,255,255,0.08);
  border-radius: 50%;
}

.header-content {
  display: flex; align-items: center; position: relative; z-index: 1; gap: 12rpx;
}

.avatar {
  width: 100rpx; height: 100rpx; border-radius: 50%;
  margin-right: 20rpx; box-shadow: 0 4rpx 12rpx rgba(0,0,0,0.15);
}

.avatar-placeholder {
  width: 100rpx; height: 100rpx;
  background: rgba(255,255,255,0.2);
  border-radius: 50%; font-size: 48rpx;
  display: flex; align-items: center; justify-content: center;
  margin-right: 20rpx;
}

.user-meta { flex: 1; }
.nickname { font-size: 32rpx; color: #fff; font-weight: bold; display: block; }
.subtitle { font-size: 22rpx; color: rgba(255,255,255,0.8); margin-top: 6rpx; display: block; }

.login-btn {
  background: rgba(255,255,255,0.25) !important;
  color: #fff !important; border: 2rpx solid rgba(255,255,255,0.5) !important;
  border-radius: 50rpx !important;
  font-size: 24rpx !important;
  padding: 0 28rpx !important;
  height: 56rpx !important; line-height: 56rpx !important;
}

/* ── 申请成为代理按钮 ── */
.apply-rider-btn {
  background: #fff !important;
  color: #FF6B35 !important;
  border: none !important;
  border-radius: 50rpx !important;
  font-size: 24rpx !important;
  padding: 0 24rpx !important;
  height: 56rpx !important;
  line-height: 56rpx !important;
  font-weight: 600;
  box-shadow: 0 4rpx 12rpx rgba(255,107,53,0.2);
}

/* ── 模式切换 ── */
.mode-switch {
  display: flex; justify-content: space-between; align-items: center;
  padding: 24rpx !important; margin: -20rpx 24rpx 0; position: relative; z-index: 2;
}

.ms-left { display: flex; align-items: baseline; gap: 12rpx; }
.ms-label { font-size: 24rpx; color: var(--text-placeholder); }
.ms-value { font-size: 26rpx; color: var(--primary); font-weight: 600; }

.ms-toggle {
  width: 140rpx;
  height: 48rpx !important; line-height: 48rpx !important;
  font-size: 22rpx !important;
}

/* ── 数据统计 ── */
.stats-section {
  display: flex;
  background: var(--card-bg);
  border-radius: 0; margin: 0 24rpx;
  padding: 28rpx; box-shadow: var(--shadow-card);
}

.stat-card { flex: 1; text-align: center; }
.stat-num { font-size: 40rpx; font-weight: bold; color: var(--text-primary); display: block; }
.stat-warn { color: #D48806; }
.stat-doing { color: #1890FF; }
.stat-done { color: #52C41A; }
.stat-label { font-size: 22rpx; color: var(--text-placeholder); margin-top: 8rpx; display: block; }

/* ── 资产快捷 ── */
.quick-section { padding-top: 28rpx !important; margin: 20rpx 24rpx 0; }
.quick-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 0; }
.quick-item { text-align: center; padding: 24rpx 0; }
.qi-icon { font-size: 44rpx; display: inline-block; margin-bottom: 10rpx; }
.qi-count { display: block; font-size: 22rpx; color: var(--primary); font-weight: 500; }
.qi-text { font-size: 24rpx; color: var(--text-secondary); margin-top: 4rpx; display: block; }

/* ── 菜单组 ── */
.menu-group { padding: 0 0 8rpx !important; margin-bottom: 20rpx !important; }
.menu-item {
  display: flex; align-items: center;
  padding: 28rpx 24rpx; transition: all 0.15s;
}
.menu-item:active { background: var(--bg); }
.menu-item:last-child { border-bottom: none; }
.menu-icon { font-size: 36rpx; margin-right: 20rpx; }
.menu-text { flex: 1; font-size: 28rpx; color: var(--text-primary); }
.menu-arrow { font-size: 32rpx; color: #ddd; }
.logout .menu-text { color: var(--danger); }

/* 骑手入口 */
.rider-entry {
  display: flex;
  align-items: center;
  padding: 24rpx 30rpx;
  margin-bottom: 20rpx;
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  border-radius: 16rpx;
  cursor: pointer;
}

.rider-icon {
  font-size: 48rpx;
  margin-right: 20rpx;
}

.rider-info {
  flex: 1;
}

.rider-title {
  display: block;
  font-size: 30rpx;
  font-weight: bold;
  color: #fff;
}

.rider-desc {
  display: block;
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.8);
  margin-top: 4rpx;
}

.rider-arrow {
  font-size: 32rpx;
  color: rgba(255, 255, 255, 0.7);
}
