.page-wallet { padding: 24rpx; padding-bottom: 60rpx; }

/* ── 余额卡片 ── */
.wallet-balance {
  background: linear-gradient(135deg, #FF6B35, #FF8F5E);
  border-radius: 20rpx; padding: 40rpx 30rpx; text-align: center; color: #fff; position: relative;
}
.wb-label { font-size: 26rpx; display: block; opacity: 0.85; }
.wb-amount { font-size: 64rpx; font-weight: bold; display: block; margin: 16rpx 0; }
.btn-topup {
  background: rgba(255,255,255,0.3) !important; color: #fff !important;
  border: none !important; border-radius: 50rpx !important;
  font-size: 24rpx !important; padding: 0 32rpx !important; height: 48rpx !important;
  position: absolute; right: 30rpx; top: 50%; transform: translateY(-50%);
}

/* ── 充值弹窗 ── */
.topup-modal {
  display: none; position: fixed; inset: 0; background: rgba(0,0,0,0.5);
  z-index: 1000; align-items: flex-end; justify-content: center;
}
.topup-modal.visible { display: flex; }
.topup-content {
  background: #fff; border-radius: 24rpx 24rpx 0 0; padding: 40rpx 30rpx; width: 100%;
}
.topup-title { font-size: 30rpx; font-weight: bold; color: var(--text-primary); display: block; margin-bottom: 24rpx; }
.topup-input {
  background: var(--bg); border-radius: 12rpx; padding: 20rpx; font-size: 32rpx; text-align: center;
  border: 2rpx solid #eee; margin-bottom: 24rpx;
}
.topup-presets { display: flex; gap: 16rpx; margin-bottom: 24rpx; }
.preset-item {
  flex: 1; text-align: center; padding: 16rpx 0; background: var(--bg); border-radius: 12rpx;
  font-size: 26rpx; color: var(--primary); font-weight: 500;
}
.btn-confirm-topup {
  background: var(--primary) !important; color: #fff !important; border: none !important;
  border-radius: 50rpx !important; font-size: 28rpx !important; padding: 0; height: 80rpx !important;
  line-height: 80rpx !important;
}

/* ── 交易记录 ── */
.tl-title { font-size: 30rpx; font-weight: bold; color: var(--text-primary); display: block; margin-bottom: 16rpx; }
.tl-item { display: flex; justify-content: space-between; align-items: center; padding: 24rpx; margin-bottom: 16rpx; }
.tl-left { display: flex; flex-direction: column; }
.tl-type { font-size: 28rpx; color: var(--text-primary); }
.tl-date { font-size: 22rpx; color: var(--text-placeholder); margin-top: 4rpx; }
.tl-amount { font-size: 30rpx; font-weight: 600; }
.positive { color: #52C41A; }
.negative { color: #FF4D4F; }

.empty-state { text-align: center; padding: 60rpx 0; }
.empty-icon { font-size: 64rpx; display: block; }
.empty-text { font-size: 24rpx; color: var(--text-placeholder); margin-top: 12rpx; display: block; }
