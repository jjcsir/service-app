<!-- 商户工作台首页 -->
<view class="page-merchant-home">
  <!-- 顶部渐变卡片 -->
  <view class="merchant-header gradient-primary">
    <text class="header-title">🏢 商户工作台</text>
    <text class="header-subtitle">{{merchantInfo.name || '加载中...'}}</text>
  </view>

  <!-- 数据概览 -->
  <view class="stats-grid card">
    <view class="stat-item">
      <text class="stat-value">{{stats.todayOrders}}</text>
      <text class="stat-label">今日订单</text>
    </view>
    <view class="stat-item">
      <text class="stat-value">{{stats.monthOrders}}</text>
      <text class="stat-label">本月订单</text>
    </view>
    <view class="stat-item">
      <text class="stat-value">¥{{stats.todayRevenue}}</text>
      <text class="stat-label">今日收入</text>
    </view>
    <view class="stat-item">
      <text class="stat-value">¥{{stats.totalRevenue}}</text>
      <text class="stat-label">累计收入</text>
    </view>
  </view>

  <!-- 快捷操作 -->
  <view class="quick-actions card">
    <view class="card-title">快捷操作</view>
    <view class="action-grid">
      <view class="action-item" bindtap="goShops">
        <text class="action-icon">🏪</text>
        <text class="action-text">店铺管理</text>
      </view>
      <view class="action-item" bindtap="goOrders">
        <text class="action-icon">📋</text>
        <text class="action-text">我的订单</text>
      </view>
      <view class="action-item" bindtap="goStaff">
        <text class="action-icon">👥</text>
        <text class="action-text">店员管理</text>
      </view>
      <view class="action-item" bindtap="goFinance">
        <text class="action-icon">💰</text>
        <text class="action-text">财务中心</text>
      </view>
    </view>
  </view>

  <!-- 最近订单 -->
  <view class="recent-orders card">
    <view class="card-header">
      <text class="card-title">最近订单</text>
      <text class="more-link" bindtap="goOrders">查看全部 ›</text>
    </view>
    <block wx:if="{{recentOrders.length > 0}}">
      <view class="order-item" wx:for="{{recentOrders}}" wx:key="id" bindtap="goOrderDetail" data-id="{{item.id}}">
        <text class="order-service">{{item.service_name}}</text>
        <text class="order-time">{{item.created_at}}</text>
        <view class="order-bottom">
          <text class="order-amount">¥{{item.actual_pay}}</text>
          <text class="order-status status-{{item.status}}">{{statusText(item.status)}}</text>
        </view>
      </view>
    </block>
    <block wx:else>
      <view class="empty-state">暂无订单</view>
    </block>
  </view>
</view>
