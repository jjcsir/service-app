/* 商户个人中心 */
@import '/app.wxss';

.container { padding: 24rpx; }

.avatar-section { background: var(--card-bg); border-radius: var(--radius-md); padding: 40rpx 0; display: flex; align-items: center; justify-content: center; margin-bottom: 24rpx; box-shadow: var(--shadow-sm); }
.avatar { width: 120rpx; height: 120rpx; border-radius: 50%; border: 3rpx solid var(--primary); }
.avatar-edit { color: var(--primary); font-size: 26rpx; margin-left: 16rpx; }

.form-section, .cert-section, .account-section, .stats-section { background: var(--card-bg); border-radius: var(--radius-md); padding: 24rpx; margin-bottom: 24rpx; box-shadow: var(--shadow-sm); }

.section-title { font-size: 30rpx; font-weight: 600; color: var(--text-primary); padding-bottom: 20rpx; border-bottom: 1rpx solid var(--border); margin-bottom: 8rpx; }

.form-item { display: flex; align-items: center; padding: 18rpx 0; border-bottom: 1rpx solid var(--border); transition: all 0.2s; }
.form-item:last-child { border-bottom: none; }
.label { width: 160rpx; font-size: 28rpx; color: var(--text-secondary); }
.input { flex: 1; font-size: 28rpx; color: var(--text-primary); text-align: right; }
.textarea { flex: 1; font-size: 28rpx; color: var(--text-primary); text-align: right; width: 400rpx; min-height: 60rpx; }

.cert-item { display: flex; align-items: center; padding: 16rpx 0; border-bottom: 1rpx solid var(--border); transition: all 0.2s; }
.cert-item:last-child { border-bottom: none; }
.cert-label { width: 160rpx; font-size: 28rpx; color: var(--text-secondary); }
.cert-status { font-size: 26rpx; padding: 4rpx 16rpx; border-radius: var(--radius-sm); margin-left: auto; }
.cert-active .cert-status { color: var(--success); background: #e8f8ee; }
.cert-pending .cert-status { color: var(--warning); background: #fff7e6; }
.cert-action { color: var(--primary); font-size: 26rpx; margin-left: 16rpx; }
.cert-value { flex: 1; font-size: 28rpx; color: var(--text-primary); text-align: right; }

.account-item { display: flex; align-items: center; padding: 20rpx 0; border-bottom: 1rpx solid var(--border); transition: all 0.2s; }
.account-item:last-child { border-bottom: none; }
.item-label { flex: 1; font-size: 28rpx; color: var(--text-primary); }
.item-arrow { font-size: 28rpx; color: var(--text-placeholder); }

.stats-grid { display: flex; flex-wrap: wrap; gap: 16rpx; }
.stat-item { width: calc(50% - 8rpx); text-align: center; padding: 20rpx 0; }
.stat-value { font-size: 36rpx; font-weight: 600; color: var(--primary); display: block; }
.stat-label { font-size: 22rpx; color: var(--text-placeholder); margin-top: 6rpx; display: block; }

.btn-save-wrap { margin: 32rpx 0 16rpx; }
.btn-save { background: var(--primary) !important; color: #fff !important; border-radius: var(--radius-round) !important; font-size: 32rpx !important; height: 88rpx !important; line-height: 88rpx !important; transition: opacity 0.2s; }
.btn-save:active { opacity: 0.8; }

.btn-logout-wrap { margin: 16rpx 0 40rpx; }
.btn-logout { background: var(--card-bg) !important; color: var(--text-placeholder) !important; border: 2rpx solid var(--border) !important; border-radius: var(--radius-round) !important; font-size: 30rpx !important; height: 80rpx !important; line-height: 80rpx !important; }
