.container {
  padding: 24rpx;
  background-color: #F5F6FA;
  min-height: 100vh;
}

/* 头像区域 */
.avatar-section {
  background: #fff;
  border-radius: 16rpx;
  padding: 40rpx 0;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 24rpx;
  position: relative;
}

.avatar {
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
  border: 3rpx solid #FF6B35;
}

.avatar-edit {
  color: #FF6B35;
  font-size: 26rpx;
  margin-left: 16rpx;
  text-decoration: underline;
}

/* 通用区块 */
.form-section,
.cert-section,
.account-section,
.stats-section {
  background: #fff;
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 24rpx;
}

.section-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #333;
  padding-bottom: 20rpx;
  border-bottom: 1rpx solid #eee;
  margin-bottom: 8rpx;
}

/* 表单 */
.form-item {
  display: flex;
  align-items: center;
  padding: 18rpx 0;
  border-bottom: 1rpx solid #f5f5f5;
}

.form-item:last-child {
  border-bottom: none;
}

.label {
  width: 160rpx;
  font-size: 28rpx;
  color: #666;
}

.input {
  flex: 1;
  font-size: 28rpx;
  color: #333;
  text-align: right;
}

.textarea {
  flex: 1;
  font-size: 28rpx;
  color: #333;
  text-align: right;
  width: 400rpx;
  min-height: 60rpx;
}

/* 认证信息 */
.cert-item {
  display: flex;
  align-items: center;
  padding: 16rpx 0;
  border-bottom: 1rpx solid #f5f5f5;
}

.cert-item:last-child {
  border-bottom: none;
}

.cert-label {
  width: 160rpx;
  font-size: 28rpx;
  color: #666;
}

.cert-status {
  font-size: 26rpx;
  padding: 4rpx 16rpx;
  border-radius: 8rpx;
  margin-left: auto;
}

.cert-active .cert-status {
  color: #07C160;
  background: #e8f8ee;
}

.cert-pending .cert-status {
  color: #FF6B35;
  background: #fff3ed;
}

.cert-action {
  color: #FF6B35;
  font-size: 26rpx;
  margin-left: 16rpx;
}

.cert-value {
  flex: 1;
  font-size: 28rpx;
  color: #333;
  text-align: right;
}

/* 账户设置 */
.account-item {
  display: flex;
  align-items: center;
  padding: 20rpx 0;
  border-bottom: 1rpx solid #f5f5f5;
}

.account-item:last-child {
  border-bottom: none;
}

.item-label {
  flex: 1;
  font-size: 28rpx;
  color: #333;
}

.item-arrow {
  font-size: 28rpx;
  color: #ccc;
}

/* 统计卡片 */
.stats-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.stat-item {
  width: calc(50% - 8rpx);
  text-align: center;
  padding: 20rpx 0;
}

.stat-value {
  font-size: 36rpx;
  font-weight: 600;
  color: #FF6B35;
  display: block;
}

.stat-label {
  font-size: 22rpx;
  color: #999;
  margin-top: 6rpx;
  display: block;
}

/* 按钮 */
.btn-save-wrap {
  margin: 32rpx 0 16rpx;
}

.btn-save {
  background: #FF6B35;
  color: #fff;
  border-radius: 48rpx;
  font-size: 32rpx;
  height: 88rpx;
  line-height: 88rpx;
}

.btn-logout-wrap {
  margin: 16rpx 0 40rpx;
}

.btn-logout {
  background: #fff;
  color: #999;
  border: 1rpx solid #ddd;
  border-radius: 48rpx;
  font-size: 30rpx;
  height: 80rpx;
  line-height: 80rpx;
}
