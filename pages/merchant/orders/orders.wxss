/* 商户端订单管理页 */
@import '/app.wxss';

.page-merchant-orders { min-height: 100vh; padding-bottom: 30rpx; }

.search-bar { display: flex; align-items: center; padding: 24rpx 30rpx; background: var(--card-bg); margin-bottom: 20rpx; }
.search-input { flex: 1; height: 64rpx; background: var(--bg); border-radius: var(--radius-round); padding: 0 24rpx; font-size: 28rpx; color: var(--text-primary); }
.search-btn { margin-left: 20rpx; font-size: 24rpx; }

.stats-row { display: flex; background: var(--card-bg); margin: 0 24rpx; border-radius: var(--radius-sm); padding: 10rpx 0; box-shadow: var(--shadow-sm); }
.stat-box { flex: 1; text-align: center; padding: 16rpx 0; transition: all 0.2s; }
.stat-box:active { background: var(--bg); }
.stat-box .num { display: block; font-size: 36rpx; font-weight: bold; color: var(--text-secondary); margin-bottom: 6rpx; transition: color 0.2s; }
.stat-box.active .num { color: var(--primary); }
.stat-box .label { font-size: 22rpx; color: var(--text-placeholder); }
.stat-box.active .label { color: var(--primary); }

.empty-state { text-align: center; padding: 200rpx 0; }
.empty-icon { font-size: 120rpx; margin-bottom: 20rpx; }
.empty-text { font-size: 28rpx; color: var(--text-placeholder); }

.order-list { padding: 0 24rpx; }
.order-card { margin-bottom: 20rpx; padding: 24rpx; transition: transform 0.2s; }
.order-card:active { transform: scale(0.99); }

.oc-top { margin-bottom: 16rpx; }
.oc-order-info { display: flex; align-items: center; }
.oc-no { font-size: 28rpx; font-weight: bold; color: var(--text-primary); margin-right: 16rpx; }
.oc-time { font-size: 22rpx; color: var(--text-placeholder); }
.oc-status { font-size: 22rpx; padding: 4rpx 16rpx; border-radius: var(--radius-round); }

.oc-body { border-top: 1rpx solid var(--border); padding-top: 16rpx; margin-bottom: 12rpx; }
.oc-row { display: flex; font-size: 26rpx; margin-bottom: 8rpx; }
.oc-label { color: var(--text-placeholder); min-width: 140rpx; }
.oc-value { color: var(--text-primary); flex: 1; }
.oc-service-name { font-weight: bold; color: var(--text-primary); }
.oc-amount { font-weight: bold; color: var(--primary); font-size: 30rpx; }

.oc-remark { background: #FFF9F0; border-left: 4rpx solid var(--warning); padding: 10rpx 16rpx; border-radius: 0 var(--radius-sm) var(--radius-sm) 0; margin-bottom: 12rpx; }
.oc-remark-text { font-size: 24rpx; color: var(--text-secondary); }

.oc-footer { border-top: 1rpx solid var(--border); padding-top: 16rpx; }
.oc-count { font-size: 24rpx; color: var(--text-placeholder); }
.oc-actions { display: flex; gap: 12rpx; }

.btn-sm { padding: 0 20rpx; height: 56rpx; line-height: 56rpx; font-size: 24rpx; border-radius: var(--radius-sm); }
.btn-warning { background: var(--warning); color: #fff; }
.btn-success { background: var(--success); color: #fff; }

.loading-mask { display: flex; flex-direction: column; align-items: center; padding: 100rpx 0; }
.loading-spinner { width: 60rpx; height: 60rpx; border: 6rpx solid var(--border); border-top-color: var(--primary); border-radius: 50%; animation: spin 1s linear infinite; }
@keyframes spin { to { transform: rotate(360deg); } }
.loading-text { font-size: 26rpx; color: var(--text-placeholder); margin-top: 20rpx; }

.load-more { text-align: center; padding: 24rpx; transition: all 0.2s; }
.load-more:active { opacity: 0.6; }
.load-more-text { font-size: 24rpx; color: var(--text-placeholder); }
.load-more.end .load-more-text { color: var(--border); }
