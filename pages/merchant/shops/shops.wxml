<view class="page-shops">
  <view class="page-header">
    <text class="page-title">我的店铺</text>
    <text class="add-btn" bindtap="showAddShop">+ 添加店铺</text>
  </view>

  <!-- 店铺列表 -->
  <view class="shop-list">
    <view class="shop-card" wx:for="{{shops}}" wx:key="id">
      <view class="shop-header">
        <image wx:if="{{item.logo}}" src="{{item.logo}}" mode="aspectFill" class="shop-logo" />
        <view class="shop-info">
          <text class="shop-name">{{item.name}}</text>
          <text class="shop-type">{{item.type_name || '未分类'}}</text>
        </view>
        <view class="shop-actions">
          <text class="action-icon" bindtap="editShop" data-id="{{item.id}}">✏️</text>
          <text class="action-icon delete" bindtap="deleteShop" data-id="{{item.id}}">🗑️</text>
        </view>
      </view>
      <view class="shop-detail">
        <text>📍 {{item.address || '暂未填写地址'}}</text>
        <text>📞 {{item.contact_phone || '暂未填写电话'}}</text>
      </view>
      <view class="shop-stats">
        <text>订单: {{item.order_count || 0}}</text>
        <text>店员: {{item.staff_count || 0}}</text>
      </view>
    </view>
  </view>

  <view wx:if="{{shops.length === 0}}" class="empty-state">
    <text>还没有店铺，快去添加吧！</text>
  </view>

  <!-- 添加/编辑店铺弹窗 -->
  <view class="modal-overlay" wx:if="{{showForm}}">
    <view class="modal-content">
      <view class="modal-title">{{isEdit ? '编辑店铺' : '添加店铺'}}</view>
      
      <view class="form-group">
        <text class="label required">店铺名称 *</text>
        <input value="{{shopForm.name}}" bindinput="onNameInput" placeholder="请输入店铺名称" />
      </view>
      
      <view class="form-group">
        <text class="label">联系电话</text>
        <input value="{{shopForm.contact_phone}}" bindinput="onPhoneInput" placeholder="请输入联系电话" type="number" maxlength="11" />
      </view>
      
      <view class="form-group">
        <text class="label">经营地址</text>
        <input value="{{shopForm.address}}" bindinput="onAddressInput" placeholder="请输入经营地址" />
      </view>
      
      <view class="form-group">
        <text class="label">店铺Logo</text>
        <view class="upload-area" bindtap="chooseLogo">
          <image wx:if="{{shopForm.logo}}" src="{{shopForm.logo}}" mode="aspectFill" class="logo-preview" />
          <text wx:else class="upload-placeholder">+ 上传Logo</text>
        </view>
      </view>

      <view class="modal-actions">
        <button class="btn-cancel" bindtap="cancelForm">取消</button>
        <button class="btn-save" bindtap="submitForm" disabled="{{loading}}">{{loading ? '保存中...' : '保存'}}</button>
      </view>
    </view>
  </view>
</view>
