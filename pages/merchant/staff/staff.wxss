/* 商户店员管理 */
@import '/app.wxss';

.page-staff { padding: 24rpx; }

.page-header { display: flex; justify-content: space-between; align-items: center; margin-bottom: 24rpx; }
.page-title { font-size: 36rpx; font-weight: bold; color: var(--text-primary); }
.add-btn { font-size: 28rpx; color: var(--primary); font-weight: 500; transition: opacity 0.2s; }
.add-btn:active { opacity: 0.6; }

.staff-card { background: var(--card-bg); border-radius: var(--radius-md); padding: 24rpx; margin-bottom: 16rpx; display: flex; align-items: center; gap: 16rpx; transition: all 0.2s; box-shadow: var(--shadow-sm); }
.staff-card:active { transform: scale(0.99); }

.staff-avatar { width: 80rpx; height: 80rpx; background: var(--primary-bg); border-radius: 50%; display: flex; align-items: center; justify-content: center; font-size: 36rpx; }
.staff-info { flex: 1; }
.staff-name { font-size: 28rpx; font-weight: 500; color: var(--text-primary); display: block; }
.staff-phone { font-size: 24rpx; color: var(--text-placeholder); margin-top: 4rpx; display: block; }
.staff-role { font-size: 22rpx; color: var(--primary); margin-top: 4rpx; display: inline-block; background: var(--primary-bg); padding: 2rpx 12rpx; border-radius: var(--radius-sm); }
.staff-actions { display: flex; gap: 12rpx; }
.action-icon { font-size: 28rpx; transition: transform 0.2s; }
.action-icon:active { transform: scale(0.9); }
.action-icon.delete { color: var(--danger); }

.empty-state { text-align: center; padding: 80rpx 0; }

/* Modal（统一样式） */
.modal-overlay { position: fixed; top: 0; left: 0; right: 0; bottom: 0; background: rgba(0,0,0,0.5); z-index: 1000; display: flex; align-items: flex-end; justify-content: center; transition: opacity 0.3s; }
.modal-content { background: var(--card-bg); width: 100%; border-radius: var(--radius-lg) var(--radius-lg) 0 0; padding: 40rpx 30rpx; max-height: 80vh; overflow-y: auto; animation: slideUp 0.3s ease; }
@keyframes slideUp { from { transform: translateY(100%); } to { transform: translateY(0); } }
.modal-title { font-size: 32rpx; font-weight: bold; margin-bottom: 30rpx; }
.form-group { margin-bottom: 20rpx; }
.label { font-size: 26rpx; color: var(--text-primary); display: block; margin-bottom: 8rpx; }
.label.required::before { content: '* '; color: var(--danger); }
.picker-value { padding: 12rpx 16rpx; border: 2rpx solid var(--border); border-radius: var(--radius-sm); font-size: 26rpx; }
.modal-actions { display: flex; gap: 20rpx; margin-top: 30rpx; }
.btn-cancel { flex: 1; padding: 16rpx; background: var(--bg); border-radius: var(--radius-sm); text-align: center; font-size: 28rpx; color: var(--text-secondary); }
.btn-save { flex: 1; padding: 16rpx; background: var(--primary); color: #fff; border-radius: var(--radius-sm); text-align: center; font-size: 28rpx; }
