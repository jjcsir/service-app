<view class="page-staff">
  <view class="page-header">
    <text class="page-title">店员列表</text>
    <text class="add-btn" bindtap="showAddStaff">+ 添加店员</text>
  </view>
  
  <view class="staff-list">
    <view class="staff-card" wx:for="{{staffList}}" wx:key="id">
      <view class="staff-avatar">👤</view>
      <view class="staff-info">
        <text class="staff-name">{{item.name}}</text>
        <text class="staff-phone">{{item.phone || '未填写电话'}}</text>
        <text class="staff-role">{{item.role || '普通店员'}}</text>
      </view>
      <view class="staff-actions">
        <text class="action-icon" bindtap="editStaff" data-id="{{item.id}}">✏️</text>
        <text class="action-icon delete" bindtap="deleteStaff" data-id="{{item.id}}">🗑️</text>
      </view>
    </view>
  </view>
  
  <view wx:if="{{staffList.length === 0}}" class="empty-state">还没有店员，去添加一个吧！</view>
  
  <!-- 添加店员弹窗 -->
  <view class="modal-overlay" wx:if="{{showForm}}">
    <view class="modal-content">
      <view class="modal-title">{{isEdit ? '编辑店员' : '添加店员'}}</view>
      <view class="form-group"><text class="label required">姓名</text><input value="{{staffForm.name}}" bindinput="onNameInput" /></view>
      <view class="form-group"><text class="label">手机号</text><input value="{{staffForm.phone}}" bindinput="onPhoneInput" type="number" maxlength="11" /></view>
      <view class="form-group"><text class="label">角色</text>
        <picker range="{{roleOptions}}" value="{{roleIndex}}" bindchange="onRoleChange">
          <view class="picker-value">{{roleOptions[roleIndex]}}</view>
        </picker>
      </view>
      <view class="modal-actions">
        <button class="btn-cancel" bindtap="cancelForm">取消</button>
        <button class="btn-save" bindtap="submitForm" disabled="{{loading}}">{{loading ? '保存中...' : '保存'}}</button>
      </view>
    </view>
  </view>
</view>
