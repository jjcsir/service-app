.tabs-bar {
  display: flex;
  background: #fff;
  padding: 20rpx 0;
  border-bottom: 1rpx solid #eee;
}
.tab-item {
  flex: 1;
  text-align: center;
  font-size: 28rpx;
  color: #666;
  padding: 10rpx 0;
}
.tab-item.active {
  color: #FF6B35;
  font-weight: bold;
  border-bottom: 4rpx solid #FF6B35;
}

.action-bar {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 16rpx 20rpx;
  background: #fff;
  margin-bottom: 10rpx;
}
.total-count {
  font-size: 24rpx;
  color: #999;
}
.mark-all-btn {
  background: #FFF5F0 !important;
  color: #FF6B35 !important;
  font-size: 22rpx !important;
}

.message-list { padding: 0 20rpx; }
.msg-card {
  background: #fff;
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 16rpx;
  position: relative;
  border-left: 6rpx solid transparent;
}
.msg-card.unread {
  border-left-color: #FF6B35;
  background: #FFFDFB;
}
.msg-card.read {
  opacity: 0.7;
}
.unread-dot {
  width: 16rpx;
  height: 16rpx;
  background: #FF6B35;
  border-radius: 50%;
  position: absolute;
  top: 24rpx;
  right: 24rpx;
}
.msg-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 12rpx;
}
.type-badge {
  padding: 4rpx 16rpx;
  border-radius: 20rpx;
  font-size: 20rpx;
  color: #fff;
}
.type-badge.order { background: #FF6B35; }
.type-badge.system { background: #2196F3; }
.type-badge.finance { background: #4CAF50; }
.msg-time {
  font-size: 22rpx;
  color: #aaa;
}
.msg-body { margin-top: 8rpx; }
.msg-title {
  display: block;
  font-size: 30rpx;
  color: #333;
  margin-bottom: 8rpx;
}
.msg-title.bold { font-weight: bold; }
.msg-content {
  display: block;
  font-size: 26rpx;
  color: #666;
  line-height: 1.6;
}

.loading-tip, .empty-state {
  text-align: center;
  padding: 80rpx 0;
  color: #ccc;
  font-size: 28rpx;
}
.empty-icon { font-size: 80rpx; display: block; margin-bottom: 20rpx; }
