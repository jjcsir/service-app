/* 商户通知页 */
@import '/app.wxss';

.tabs-bar { display: flex; background: var(--card-bg); padding: 20rpx 0; border-bottom: 1rpx solid var(--border); }
.tab-item { flex: 1; text-align: center; font-size: 28rpx; color: var(--text-placeholder); padding: 10rpx 0; transition: all 0.2s; }
.tab-item.active { color: var(--primary); font-weight: bold; border-bottom: 4rpx solid var(--primary); }

.action-bar { display: flex; justify-content: space-between; align-items: center; padding: 16rpx 24rpx; background: var(--card-bg); margin-bottom: 16rpx; box-shadow: var(--shadow-sm); }
.total-count { font-size: 24rpx; color: var(--text-placeholder); }
.mark-all-btn { background: var(--primary-bg) !important; color: var(--primary) !important; font-size: 22rpx !important; transition: opacity 0.2s; }
.mark-all-btn:active { opacity: 0.7; }

.message-list { padding: 0 24rpx; }
.msg-card { background: var(--card-bg); border-radius: var(--radius-md); padding: 24rpx; margin-bottom: 16rpx; position: relative; border-left: 6rpx solid transparent; box-shadow: var(--shadow-sm); transition: all 0.2s; }
.msg-card:active { transform: scale(0.99); }
.msg-card.unread { border-left-color: var(--primary); background: var(--primary-bg); }
.msg-card.read { opacity: 0.7; }
.unread-dot { width: 16rpx; height: 16rpx; background: var(--primary); border-radius: 50%; position: absolute; top: 24rpx; right: 24rpx; animation: pulse 1.5s infinite; }
@keyframes pulse { 0%, 100% { transform: scale(1); } 50% { transform: scale(1.2); } }

.msg-header { display: flex; justify-content: space-between; align-items: center; margin-bottom: 12rpx; }
.type-badge { padding: 4rpx 16rpx; border-radius: var(--radius-round); font-size: 20rpx; color: #fff; }
.type-badge.order { background: var(--primary); }
.type-badge.system { background: var(--secondary); }
.type-badge.finance { background: var(--success); }
.msg-time { font-size: 22rpx; color: var(--text-placeholder); }
.msg-body { margin-top: 8rpx; }
.msg-title { display: block; font-size: 30rpx; color: var(--text-primary); margin-bottom: 8rpx; }
.msg-title.bold { font-weight: bold; }
.msg-content { display: block; font-size: 26rpx; color: var(--text-secondary); line-height: 1.6; }

.loading-tip, .empty-state { text-align: center; padding: 80rpx 0; color: var(--text-placeholder); font-size: 28rpx; }
.empty-icon { font-size: 80rpx; display: block; margin-bottom: 20rpx; }
