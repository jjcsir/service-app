@import '/app.wxss';
.page-finance { padding-bottom: 30rpx; }
.balance-card { margin: 24rpx; padding: 40rpx; border-radius: 20rpx; text-align: center; }
.balance-label { font-size: 26rpx; color: rgba(255,255,255,0.85); }
.balance-amount { font-size: 64rpx; font-weight: bold; color: #fff; margin: 10rpx 0; display: block; }
.withdraw-btn { background: rgba(255,255,255,0.2); color: #fff; border: none; border-radius: 30rpx; padding: 12rpx 40rpx; font-size: 28rpx; margin-top: 20rpx; }
.summary-grid { margin: 0 24rpx; display: flex; justify-content: space-around; padding: 30rpx 0; }
.summary-item { text-align: center; }
.summary-item .value { font-size: 32rpx; font-weight: bold; display: block; }
.summary-item .label { font-size: 22rpx; color: var(--text-secondary); display: block; }
.tabs { display: flex; margin: 24rpx 24rpx 0; background: #fff; border-radius: 12rpx; overflow: hidden; }
.tab { flex: 1; text-align: center; padding: 16rpx 0; font-size: 26rpx; color: var(--text-secondary); }
.tab.active { color: var(--primary); font-weight: bold; background: var(--primary-bg); }
.transaction-list { margin: 16rpx 24rpx; }
.trans-item { display: flex; justify-content: space-between; align-items: center; padding: 20rpx 0; border-bottom: 1rpx solid var(--border); }
.trans-desc { font-size: 26rpx; display: block; }
.trans-time { font-size: 22rpx; color: var(--text-secondary); margin-top: 4rpx; display: block; }
.trans-amount { font-size: 30rpx; font-weight: bold; }
.income { color: #52c41a; }
.expense { color: #ff4d4f; }
