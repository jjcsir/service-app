/* 商户财务中心 */
@import '/app.wxss';

.page-finance { padding-bottom: 30rpx; }

.balance-card { 
  margin: 24rpx; 
  padding: 40rpx; 
  border-radius: var(--radius-lg); 
  text-align: center; 
  background: linear-gradient(135deg, var(--primary), var(--primary-light));
  transition: transform 0.2s;
}
.balance-card:active { transform: scale(0.98); }
.balance-label { font-size: 26rpx; color: rgba(255,255,255,0.85); }
.balance-amount { font-size: 64rpx; font-weight: bold; color: #fff; margin: 10rpx 0; display: block; }

.withdraw-btn { background: rgba(255,255,255,0.2); color: #fff; border: none; border-radius: var(--radius-round); padding: 12rpx 40rpx; font-size: 28rpx; margin-top: 20rpx; transition: all 0.2s; }

.summary-grid { margin: 0 24rpx; display: flex; justify-content: space-around; padding: 30rpx 0; background: var(--card-bg); border-radius: var(--radius-sm); }
.summary-item { text-align: center; }
.summary-item .value { font-size: 32rpx; font-weight: bold; color: var(--text-primary); display: block; }
.summary-item .label { font-size: 22rpx; color: var(--text-placeholder); display: block; }

.tabs { display: flex; margin: 24rpx 24rpx 0; background: var(--bg); border-radius: var(--radius-sm); overflow: hidden; padding: 4rpx; }
.tab { flex: 1; text-align: center; padding: 12rpx 0; font-size: 26rpx; color: var(--text-secondary); border-radius: var(--radius-sm); transition: all 0.2s; }
.tab.active { color: var(--primary); font-weight: bold; background: var(--card-bg); box-shadow: var(--shadow-sm); }

.transaction-list { margin: 16rpx 24rpx; }
.trans-item { display: flex; justify-content: space-between; align-items: center; padding: 20rpx 0; border-bottom: 1rpx solid var(--border); transition: all 0.2s; }
.trans-item:active { background: var(--bg); }
.trans-desc { font-size: 26rpx; color: var(--text-primary); }
.trans-time { font-size: 22rpx; color: var(--text-placeholder); }
.trans-amount { font-size: 30rpx; font-weight: bold; }

.income { color: var(--success); }
.expense { color: var(--danger); }
