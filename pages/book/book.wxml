<!-- 预约页 ── UI重构 -->
<view class="page-book">
  
  <!-- 服务信息卡 -->
  <view class="service-card">
    <view class="svc-top">
      <view class="svc-icon-box">
        <text class="svc-emoji">{{service.emoji || (service.emoji_map && service.emoji_map[service.category_name]) || 'U1F527'}}</text>
      </view>
      <view class="svc-info">
        <text class="svc-name">{{service.name}}</text>
        <text class="svc-cat">{{service.category_name}}</text>
        <text class="svc-desc">{{service.description}}</text>
      </view>
    </view>
    <view class="svc-bottom-row">
      <view class="price-block">
        <text class="price-label">参考价</text>
        <text class="price-value">¥{{servicePrice}}</text>
        <text class="price-unit">/{{service.unit || '次'}}</text>
      </view>
    </view>
  </view>

  <!-- 日期选择 -->
  <view class="section card">
    <view class="section-title-row"><text class="label">📅 选择日期</text></view>
    <scroll-view scroll-x class="date-scroll">
      <view class="date-item {{currentDateIndex==index?'active':''}}" 
            wx:for="{{dates}}" wx:key="index" bindtap="selectDate" data-index="{{index}}">
        <text class="date-day">{{item.day}}</text>
        <text class="date-week">{{item.week}}</text>
      </view>
    </scroll-view>
  </view>

  <!-- 时段选择 -->
  <view class="section card">
    <view class="section-title-row"><text class="label">⏰ 选择时间</text></view>
    <view class="time-grid">
      <view class="time-item {{currentTimeSlot==index?'active':''}}" 
            wx:for="{{timeSlots}}" wx:key="*this" bindtap="selectTime" data-index="{{index}}">
        <text>{{item}}</text>
      </view>
    </view>
  </view>

  <!-- 地址 -->
  <view class="section card">
    <view class="section-title-row"><text class="label">📍 服务地址</text></view>
    <view class="address-row">
      <input class="input-field" placeholder="请输入详细地址" value="{{detailAddress}}" bindinput="onAddressInput" />
      <view class="geo-btn" bindtap="getLocation">📌 定位</view>
    </view>
  </view>

  <!-- 备注 -->
  <view class="section card">
    <view class="section-title-row"><text class="label">📝 备注</text></view>
    <textarea class="input-area" placeholder="如有特殊要求请备注（选填）" 
              value="{{remark}}" bindinput="onRemarkInput" maxlength="200" />
  </view>

  <!-- 费用明细 -->
  <view class="section card">
    <view class="section-title-row"><text class="label">💰 费用明细</text></view>
    <view class="cost-list">
      <view class="cost-row">
        <text class="cost-label">服务费</text>
        <text class="cost-val">¥{{servicePrice}}</text>
      </view>
      <view class="cost-row">
        <text class="cost-label">上门费</text>
        <text class="cost-val cost-free">免</text>
      </view>
      <view class="divider"></view>
      <view class="cost-row total">
        <text class="cost-label">合计</text>
        <text class="cost-val cost-total">¥{{totalPrice}}</text>
      </view>
    </view>
  </view>

  <view style="height: 160rpx;"></view>

  <!-- 底部固定栏 -->
  <view class="bottom-bar">
    <view class="total-info">
      <text class="total-label">合计：</text>
      <text class="total-price">¥{{totalPrice}}</text>
    </view>
    <button class="submit-btn btn-primary" loading="{{loading}}" disabled="{{loading}}" bindtap="submitOrder">
      {{loading ? '提交中...' : '立即预约'}}
    </button>
  </view>
</view>
