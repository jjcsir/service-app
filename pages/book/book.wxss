.container { padding: 20rpx; padding-bottom: 140rpx; }

.service-header {
  display: flex;
  align-items: center;
  background: #fff;
  border-radius: 16rpx;
  padding: 30rpx;
  margin-bottom: 20rpx;
}

.service-logo {
  width: 120rpx;
  height: 120rpx;
  border-radius: 12rpx;
  background: #FFF3ED;
  margin-right: 20rpx;
}

.s-name { font-size: 34rpx; font-weight: bold; }
.s-price { font-size: 36rpx; color: #FF6B35; font-weight: bold; margin-top: 10rpx; }
.s-cat { font-size: 22rpx; color: #999; margin-top: 6rpx; }

.section {
  background: #fff;
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 20rpx;
}

.label {
  font-size: 30rpx;
  font-weight: bold;
  margin-bottom: 16rpx;
  display: block;
}

.date-scroll {
  white-space: nowrap;
  padding-bottom: 10rpx;
}

.date-item {
  display: inline-block;
  width: 120rpx;
  text-align: center;
  padding: 16rpx 0;
  margin-right: 12rpx;
  background: #f5f5f5;
  border-radius: 12rpx;
}

.date-item.active {
  background: #FFF3ED;
  border: 2rpx solid #FF6B35;
}

.date-day { font-size: 32rpx; font-weight: bold; display: block; }
.date-week { font-size: 22rpx; color: #999; margin-top: 4rpx; display: block; }

.time-slots {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.time-item {
  padding: 12rpx 24rpx;
  background: #f5f5f5;
  border-radius: 8rpx;
  font-size: 26rpx;
}

.time-item.active {
  background: #FF6B35;
  color: white;
}

.input-area {
  width: 100%;
  height: 120rpx;
  border: 2rpx solid #eee;
  border-radius: 12rpx;
  padding: 16rpx;
  font-size: 28rpx;
  box-sizing: border-box;
}

.cost-row {
  display: flex;
  justify-content: space-between;
  padding: 12rpx 0;
  font-size: 28rpx;
  color: #666;
}

.cost-price { color: #333; }
.cost-free { color: #52c41a; }

.total {
  border-top: 2rpx dashed #eee;
  margin-top: 10rpx;
  padding-top: 20rpx;
  font-weight: bold;
  font-size: 30rpx;
}

.total-price { color: #FF6B35; font-size: 36rpx; }

.bottom-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  display: flex;
  align-items: center;
  justify-content: space-between;
  background: #fff;
  padding: 20rpx 30rpx;
  box-shadow: 0 -4rpx 12rpx rgba(0,0,0,0.05);
}

.big-price { font-size: 40rpx; color: #FF6B35; font-weight: bold; margin-left: 10rpx; }

.submit-btn {
  background: #FF6B35 !important;
  color: #fff !important;
  border-radius: 44rpx !important;
  font-size: 30rpx !important;
  padding: 0 40rpx !important;
  height: 80rpx !important;
  line-height: 80rpx !important;
}
