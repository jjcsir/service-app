.order-card {
  background: #fff;
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 20rpx;
}

.order-header {
  display: flex;
  justify-content: space-between;
  margin-bottom: 16rpx;
}

.order-no { font-size: 24rpx; color: #999; }
.order-status { font-size: 26rpx; font-weight: bold; color: #FF6B35; }

.order-body { margin-bottom: 16rpx; }
.order-service { font-size: 30rpx; font-weight: bold; display: block; margin-bottom: 8rpx; }
.order-date { font-size: 26rpx; color: #666; display: block; margin-bottom: 4rpx; }
.order-address { font-size: 24rpx; color: #999; }

.order-footer {
  display: flex;
  justify-content: space-between;
  align-items: center;
  border-top: 2rpx solid #f5f5f5;
  padding-top: 16rpx;
}

.order-price { font-size: 34rpx; color: #FF6B35; font-weight: bold; }

.action-btn {
  margin-left: 12rpx;
  font-size: 24rpx !important;
  padding: 0 24rpx !important;
  height: 56rpx !important;
  line-height: 56rpx !important;
}

.cancel { border: 2rpx solid #ccc; color: #999 !important; background: #fff !important; }
.confirm { background: #FF6B35 !important; color: #fff !important; }

.empty-tip {
  text-align: center;
  padding: 200rpx 0;
  color: #999;
  font-size: 30rpx;
}
