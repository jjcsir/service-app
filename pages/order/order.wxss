/* ============================================
   订单页 ── UI设计
   ============================================ */

.page-order { padding-bottom: 100rpx; }

/* ── Tab Bar ── */
.tab-bar {
  display: flex;
  background: var(--card-bg);
  padding: 0 24rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.04);
}

.tab-item {
  flex: 1;
  text-align: center;
  padding: 24rpx 0;
  position: relative;
  transition: all 0.2s;
}

.tab-label { font-size: 28rpx; color: var(--text-placeholder); }

.tab-item.active .tab-label { color: var(--primary); font-weight: 600; }

.tab-dot {
  width: 32rpx;
  height: 6rpx;
  background: var(--primary);
  border-radius: 3rpx;
  margin: 8rpx auto 0;
}

/* ── 订单卡片 ── */
.order-card { padding: 24rpx !important; }

.order-header { margin-bottom: 4rpx; }

.order-no { font-size: 24rpx; color: var(--text-placeholder); font-family: monospace; }

/* ── 状态标签（复用全局） ── */
.status-tag { font-size: 22rpx; padding: 4rpx 16rpx; }
.status-pending { background: #FFF7E6; color: #D48806; }
.status-doing   { background: #E6F7FF; color: #1890FF; }
.status-done    { background: #F6FFED; color: #52C41A; }
.status-cancelled { background: #FFF1F0; color: #FF4D4F; }
.status-default { background: #F5F5F5; color: #999; }

/* ── 服务信息行 ── */
.order-service-row { display: flex; align-items: center; gap: 16rpx; padding: 12rpx 0; }

.svc-icon { font-size: 44rpx; flex-shrink: 0; }

.svc-details { flex: 1; min-width: 0; }

.svc-name { 
  font-size: 28rpx; 
  font-weight: 500; 
  display: block; 
  margin-bottom: 6rpx; 
}

.svc-address { 
  font-size: 22rpx; 
  color: var(--text-placeholder); 
  display: block; 
}

/* ── 底部栏 ── */
.order-footer { padding-top: 16rpx !important; }

.amount { font-size: 34rpx; color: var(--primary); font-weight: bold; }

.action-btns { display: flex; gap: 16rpx; }

.cancel-btn {
  font-size: 24rpx !important;
  color: var(--danger) !important;
  background: transparent !important;
  border: none !important;
  padding: 0 !important;
  height: auto !important;
  line-height: normal !important;
}

.detail-btn {
  font-size: 24rpx !important;
  color: var(--secondary) !important;
  background: transparent !important;
  border: none !important;
  padding: 0 !important;
  height: auto !important;
  line-height: normal !important;
}

/* ── 空状态 ── */
.empty-state { text-align: center; padding: 120rpx 0; }
.empty-icon { font-size: 100rpx; opacity: 0.3; display: block; }
.empty-text { font-size: 28rpx; color: var(--text-placeholder); margin-top: 16rpx; display: block; }
