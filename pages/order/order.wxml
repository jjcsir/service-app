<!-- 订单页 ── UI重构 -->
<view class="page-order">
  
  <!-- Tab Bar -->
  <view class="tab-bar">
    <view class="tab-item {{activeTab==index?'active':''}}" 
          wx:for="{{tabs}}" wx:key="index" 
          bindtap="switchTab" data-index="{{index}}">
      <text class="tab-label">{{item.label}}</text>
      <view class="tab-dot" wx:if="{{activeTab==index}}"></view>
    </view>
  </view>

  <!-- 订单列表 -->
  <block wx:if="{{orders.length > 0}}">
    <view class="order-card card" wx:for="{{orders}}" wx:key="order_no">
      
      <!-- 头部：订单号 + 状态 -->
      <view class="order-header flex-between">
        <text class="order-no">{{item.order_no}}</text>
        <text class="status-tag {{getStatusClass(item.status)}}">{{getStatusLabel(item.status)}}</text>
      </view>

      <view class="divider"></view>

      <!-- 服务信息 -->
      <view class="order-body">
        <view class="order-service-row">
          <text class="svc-icon">{{getItemEmoji(item.service_name)}}</text>
          <view class="svc-details">
            <text class="svc-name text-ellipsis">{{item.service_name || '上门服务'}}</text>
            <text class="svc-address">📍 {{item.start_address || item.detail_address || '地址待填写'}}</text>
          </view>
        </view>
      </view>

      <!-- 底部 -->
      <view class="order-footer flex-between">
        <text class="amount">¥{{item.paid_amount || item.total_amount || 0}}</text>
        <view class="action-btns">
          <!-- 待抢单/已指派 → 可取消 -->
          <button wx:if="{{item.status == 0 || item.status == 5}}" 
                  class="btn-text" size="mini"
                  bindtap="cancelOrder" data-id="{{item.order_no}}">
            取消
          </button>
          <!-- 已接单 → 查看详情 -->
          <button wx:if="{{item.status == 1}}" 
                  class="btn-text" size="mini" type="primary"
                  bindtap="showDetail" data-orderid="{{item.order_no}}">
            查看
          </button>
        </view>
      </view>
    </view>
  </block>

  <!-- 空状态 -->
  <view class="empty-state" wx:else>
    <text class="empty-icon">📋</text>
    <text class="empty-text">暂无{{tabs[activeTab]?.label || ''}}订单</text>
  </view>

  <view style="height: 100rpx;"></view>
</view>
