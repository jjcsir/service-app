<view class="container">
  <view class="empty-tip" wx:if="{{orders.length == 0}}">
    <text>暂无订单</text>
  </view>

  <view class="order-card" wx:for="{{orders}}" wx:key="id">
    <view class="order-header">
      <text class="order-no">订单号：{{item.id}}</text>
      <text class="order-status {{item.status}}">{{item.status}}</text>
    </view>
    <view class="order-body">
      <text class="order-service">{{item.serviceName}}</text>
      <text class="order-date">{{item.date}} {{item.time}}</text>
      <text class="order-address">📍 {{item.address}}</text>
    </view>
    <view class="order-footer">
      <text class="order-price">¥{{item.servicePrice}}</text>
      <view class="order-actions">
        <button class="action-btn cancel" size="mini" bindtap="cancelOrder" data-id="{{item.id}}">取消</button>
        <button class="action-btn confirm" size="mini" bindtap="showDetail" data-id="{{item.id}}">详情</button>
      </view>
    </view>
  </view>
</view>
