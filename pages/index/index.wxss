/* ============================================
   首页 ── 全新UI设计
   ============================================ */

.page-index { padding-bottom: 160rpx; }

/* ── 搜索栏 ── */
.search-wrapper {
  background: linear-gradient(135deg, #FF6B35, #FF8F5E);
  padding: 30rpx 24rpx 20rpx;
  margin: -24rpx -24rpx 0;
}

.search-bar {
  display: flex;
  align-items: center;
  background: #fff;
  border-radius: 44rpx;
  padding: 0 28rpx;
  height: 72rpx;
}

.search-icon { font-size: 30rpx; margin-right: 16rpx; }

.search-input {
  flex: 1;
  font-size: 28rpx;
  color: var(--text-primary);
}

/* ── 轮播图 ── */
.banner-swiper {
  height: 320rpx;
  margin: 20rpx 0;
  border-radius: var(--radius-md);
  overflow: hidden;
}

.banner-image { width: 100%; height: 100%; }

/* ── 分类网格 4x2 ── */
.category-section { padding-top: 28rpx !important; }

.category-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 0 0;
  padding: 10rpx 0 10rpx;
}

.cat-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 16rpx 0;
  transition: all 0.2s;
}

.cat-item:active { transform: scale(0.95); }

.cat-item.active .cat-img-box { background: var(--primary-bg); }
.cat-item.active .cat-label { color: var(--primary); font-weight: 600; }

.cat-img-box {
  width: 80rpx;
  height: 80rpx;
  background: var(--bg);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 10rpx;
  transition: all 0.2s;
}

.cat-emoji { font-size: 36rpx; }
.cat-label { font-size: 22rpx; color: var(--text-secondary); }

/* ── 横向滚动服务卡片 ── */
.hot-section { padding: 24rpx 0; }

.service-scroll {
  white-space: nowrap;
  padding-left: 0;
}

.service-scroll-inner {
  display: inline-flex;
  gap: 16rpx;
}

.service-card-sm {
  display: inline-flex;
  flex-direction: column;
  width: 200rpx;
  background: var(--card-bg);
  border-radius: var(--radius-md);
  box-shadow: var(--shadow-card);
  padding: 20rpx;
}

.svc-thumb { text-align: center; }

.svc-emoji {
  font-size: 52rpx;
  display: block;
  line-height: 1;
}

.svc-info { margin-top: 12rpx; }
.svc-name { font-size: 26rpx; font-weight: 500; display: block; margin-bottom: 4rpx; }
.svc-cat { font-size: 20rpx; color: var(--text-placeholder); display: block; margin-bottom: 8rpx; }
.svc-price { font-size: 30rpx; color: var(--primary); font-weight: bold; display: block; }

/* ── 完整服务列表 ── */
.service-list { display: flex; flex-direction: column; gap: 0; }

.service-card-lg {
  display: flex;
  padding: 24rpx 0;
  border-bottom: 1rpx solid var(--border);
  transition: all 0.15s;
}

.service-card-lg:active { background: var(--bg); }
.service-card-lg:last-child { border-bottom: none; }

.card-left {
  flex-shrink: 0;
  margin-right: 20rpx;
}

.svc-img-box-lg {
  width: 120rpx;
  height: 120rpx;
  background: linear-gradient(135deg, var(--primary-bg), #FFF);
  border-radius: var(--radius-md);
  display: flex;
  align-items: center;
  justify-content: center;
}

.svc-emoji-lg { font-size: 48rpx; }

.card-right { flex: 1; min-width: 0; }

.svc-name-lg {
  font-size: 30rpx;
  font-weight: 600;
  display: block;
  margin-bottom: 8rpx;
}

.svc-desc {
  font-size: 24rpx;
  color: var(--text-placeholder);
  display: block;
  margin-bottom: 16rpx;
}

.svc-bottom {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.price-wrap { display: flex; align-items: baseline; }

.price-new {
  font-size: 34rpx;
  color: var(--primary);
  font-weight: bold;
}

.price-unit {
  font-size: 22rpx;
  color: var(--text-placeholder);
  margin-left: 4rpx;
}

.book-btn-lg {
  font-size: 24rpx !important;
  padding: 0 24rpx !important;
  height: 52rpx !important;
  line-height: 52rpx !important;
}

/* ── 空状态 ── */
.empty-state { text-align: center; padding: 80rpx 0; }
.empty-icon { font-size: 80rpx; opacity: 0.3; }
.empty-text { font-size: 26rpx; color: var(--text-placeholder); margin-top: 16rpx; display: block; }
