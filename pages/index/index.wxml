<view class="container">
  <!-- 搜索栏 -->
  <view class="search-bar">
    <icon type="search" size="14" color="#999"/>
    <input placeholder="搜索服务项目" bindinput="onSearch" />
  </view>

  <!-- 轮播图 -->
  <swiper class="banner" indicator-dots autoplay circular indicator-color="rgba(255,255,255,0.5)" indicator-active-color="#FF6B35">
    <swiper-item wx:for="{{banners}}" wx:key="*this">
      <image src="{{item}}" mode="aspectFill" class="banner-img" />
    </swiper-item>
  </swiper>

  <!-- 服务分类 -->
  <view class="category-grid">
    <view class="category-item" wx:for="{{categories}}" wx:key="id" bindtap="goCategory" data-id="{{item.id}}">
      <image src="{{item.icon}}" class="cat-icon" />
      <text class="cat-name">{{item.name}}</text>
    </view>
  </view>

  <!-- 热门推荐 -->
  <view class="section-title">
    <text>🔥 热门推荐</text>
    <text class="more">查看全部 ></text>
  </view>

  <view class="service-list">
    <view class="service-card" wx:for="{{services}}" wx:key="id" bindtap="goBook" data-id="{{item.id}}">
      <image src="{{item.icon}}" class="service-img" />
      <view class="service-info">
        <text class="service-name">{{item.name}}</text>
        <text class="service-cat">{{item.category}}</text>
        <view class="price-row">
          <view>
            <text class="price">¥{{item.price}}</text>
            <text class="original-price">¥{{item.price + 50}}</text>
          </view>
          <button class="book-btn" size="mini" type="warn" catchtap="goBook" data-id="{{item.id}}">预约</button>
        </view>
      </view>
    </view>
  </view>

  <!-- 底部间距 -->
  <view style="height: 100rpx;"></view>
</view>
