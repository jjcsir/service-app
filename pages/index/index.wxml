<!-- 首页 ── UI重构 -->
<view class="page-index">
  <!-- 搜索栏（渐变背景） -->
  <view class="search-wrapper">
    <view class="search-bar">
      <text class="search-icon">🔍</text>
      <input 
        class="search-input" 
        placeholder="搜索服务项目" 
        value="{{searchKeyword}}"
        bindinput="onSearch"
        confirm-type="search"
      />
    </view>
  </view>

  <!-- 轮播图 -->
  <swiper class="banner-swiper" autoplay circular indicator-dots indicator-active-color="#FF6B35" indicator-color="rgba(255,255,255,0.4)">
    <swiper-item wx:for="{{banners}}" wx:key="index">
      <image src="{{item.image || item}}" mode="aspectFill" class="banner-image" />
    </swiper-item>
  </swiper>

  <!-- 分类网格（4x2） -->
  <view class="category-section card">
    <view class="section-header">
      <text class="section-title">服务分类</text>
    </view>
    <view class="category-grid">
      <view class="cat-item {{currentCategory==''?'active':''}}" bindtap="goCategory" data-id="">
        <view class="cat-img-box"><text class="cat-emoji">🏠</text></view>
        <text class="cat-label">全部</text>
      </view>
      <view class="cat-item {{currentCategory==c.id?'active':''}}" 
            wx:for="{{categories}}" wx:key="id"
            bindtap="goCategory" data-id="{{item.id}}">
        <view class="cat-img-box"><text class="cat-emoji">{{item.emoji || getItemEmoji(item.name)}}</text></view>
        <text class="cat-label">{{item.name}}</text>
      </view>
    </view>
  </view>

  <!-- 热门推荐 -->
  <view class="hot-section">
    <view class="section-header">
      <text class="section-title">🔥 {{currentCategory ? currentCategoryName : '热门推荐'}}</text>
    </view>

    <scroll-view scroll-x class="service-scroll" wx:if="{{filteredServices.length > 0}}">
      <view class="service-scroll-inner">
        <view class="service-card-sm" wx:for="{{filteredServices}}" wx:key="id" 
              bindtap="goBook" data-id="{{item.id}}">
          <view class="svc-thumb">
            <text class="svc-emoji">{{item.emoji || getItemEmoji(item.name)}}</text>
          </view>
          <view class="svc-info">
            <text class="svc-name text-ellipsis">{{item.name}}</text>
            <text class="svc-cat">{{item.category_name}}</text>
            <text class="svc-price">¥{{item.price}}</text>
          </view>
        </view>
      </view>
    </scroll-view>
  </view>

  <!-- 完整服务列表 -->
  <view class="service-list-section card" wx:if="{{services.length > 0}}">
    <view class="section-header">
      <text class="section-title">所有服务</text>
    </view>
    <view class="service-list">
      <view class="service-card-lg" wx:for="{{services}}" wx:key="id"
            bindtap="goBook" data-id="{{item.id}}">
        <view class="card-left">
          <view class="svc-img-box-lg">
            <text class="svc-emoji-lg">{{item.emoji || getItemEmoji(item.name)}}</text>
          </view>
        </view>
        <view class="card-right">
          <text class="svc-name-lg text-ellipsis">{{item.name}}</text>
          <text class="svc-desc text-ellipsis">{{item.description || item.category_name}}</text>
          <view class="svc-bottom">
            <view class="price-wrap">
              <text class="price-new">¥{{item.price}}</text>
              <text class="price-unit">/{{item.unit || '次'}}</text>
            </view>
            <button class="book-btn-lg" size="mini" type="primary" class="btn-primary">
              预约
            </button>
          </view>
        </view>
      </view>
    </view>
  </view>

  <!-- 空状态 -->
  <view class="empty-state" wx:if="{{services.length === 0 && !loading}}">
    <text class="empty-icon">📦</text>
    <text class="empty-text">暂无服务内容</text>
  </view>

  <view style="height: 100rpx;"></view>
</view>
