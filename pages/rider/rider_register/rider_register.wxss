.page-register {
  padding: 30rpx;
  min-height: 100vh;
  background: #f5f6fa;
}

.register-header {
  text-align: center;
  margin-bottom: 40rpx;
}

.register-header .title {
  display: block;
  font-size: 40rpx;
  font-weight: bold;
  color: #333;
}

.register-header .subtitle {
  display: block;
  font-size: 26rpx;
  color: #999;
  margin-top: 10rpx;
}

.register-form {
  padding: 30rpx;
  border-radius: 16rpx;
  background: #fff;
}

.form-item {
  margin-bottom: 30rpx;
}

.form-label {
  display: block;
  font-size: 28rpx;
  color: #333;
  margin-bottom: 12rpx;
}

.form-label.required::before {
  content: '* ';
  color: #e74c3c;
}

.optional {
  font-size: 24rpx;
  color: #999;
}

.form-input {
  width: 100%;
  height: 80rpx;
  padding: 0 20rpx;
  border: 1rpx solid #e0e0e0;
  border-radius: 8rpx;
  font-size: 28rpx;
  box-sizing: border-box;
}

.id-card-upload {
  width: 200rpx;
  height: 200rpx;
  border: 2rpx dashed #ccc;
  border-radius: 8rpx;
  overflow: hidden;
}

.upload-placeholder {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  height: 100%;
}

.upload-icon {
  font-size: 48rpx;
}

.upload-text {
  font-size: 22rpx;
  color: #999;
  margin-top: 8rpx;
}

.id-card-preview {
  width: 100%;
  height: 100%;
}

.vehicle-picker {
  width: 100%;
}

.picker-value {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.picker-arrow {
  font-size: 22rpx;
  color: #999;
}

.submit-btn {
  width: 100%;
  height: 88rpx;
  line-height: 88rpx;
  text-align: center;
  font-size: 32rpx;
  color: #fff;
  background: #2979ff;
  border-radius: 44rpx;
  margin-top: 40rpx;
}

.back-link {
  text-align: center;
  margin-top: 30rpx;
  font-size: 28rpx;
  color: #2979ff;
}
