<!-- 骑手注册页 -->
<view class="page-register">
  <view class="register-header">
    <text class="title">🛵 骑手注册</text>
    <text class="subtitle">填写信息，成为我们的配送伙伴</text>
  </view>

  <view class="register-form card">
    <!-- 真实姓名 -->
    <view class="form-item">
      <text class="form-label required">真实姓名</text>
      <input class="form-input" placeholder="请输入真实姓名" value="{{realname}}" data-field="realname" bindinput="onInputChange" />
    </view>

    <!-- 手机号 -->
    <view class="form-item">
      <text class="form-label required">手机号</text>
      <input class="form-input" type="number" maxlength="11" placeholder="请输入手机号" value="{{phone}}" data-field="phone" bindinput="onInputChange" />
    </view>

    <!-- 身份证照片（选填） -->
    <view class="form-item">
      <text class="form-label">身份证照片 <text class="optional">(选填)</text></text>
      <view class="id-card-upload" bindtap="onChooseImage">
        <image wx:if="{{idCardFront.length > 0}}" src="{{idCardFront[0]}}" class="id-card-preview" mode="aspectFill" />
        <view wx:else class="upload-placeholder">
          <text class="upload-icon">📷</text>
          <text class="upload-text">点击上传身份证正面</text>
        </view>
      </view>
    </view>

    <!-- 交通工具类型 -->
    <view class="form-item">
      <text class="form-label required">交通工具</text>
      <picker class="vehicle-picker" range="{{vehicleTypes}}" value="{{vehicleTypes.indexOf(vehicleType)}}" bindchange="onVehicleTypeChange">
        <view class="form-input picker-value">
          {{vehicleType}}
          <text class="picker-arrow">▼</text>
        </view>
      </picker>
    </view>

    <!-- 提交按钮 -->
    <button class="submit-btn" loading="{{submitting}}" disabled="{{submitting}}" bindtap="onSubmit">
      提交注册
    </button>
  </view>

  <view class="back-link" bindtap="goBack">← 返回</view>
</view>
