.page-rider-orders { padding-bottom: 100rpx; }

.tab-bar {
  display: flex;
  background: #fff;
  margin-bottom: 20rpx;
}
.tab-item {
  flex: 1;
  text-align: center;
  padding: 24rpx 0;
  font-size: 28rpx;
  color: var(--text-placeholder);
  position: relative;
}
.tab-item.active { color: var(--primary); font-weight: 600; }
.tab-item.active::after {
  content: '';
  position: absolute;
  bottom: 0;
  left: 50%;
  transform: translateX(-50%);
  width: 40rpx;
  height: 4rpx;
  background: var(--primary);
  border-radius: 2rpx;
}

.ro-card { padding: 24rpx !important; margin-bottom: 16rpx !important; }
.ro-header { margin-bottom: 8rpx; }
.ro-no { font-size: 22rpx; color: var(--text-placeholder); }
.ro-status { font-size: 20rpx; padding: 4rpx 12rpx; }

.ro-body { margin-bottom: 16rpx; }
.ro-service { font-size: 28rpx; font-weight: 500; display: block; margin-bottom: 6rpx; }
.ro-address { font-size: 22rpx; color: var(--text-placeholder); display: block; }

.ro-footer { display: flex; justify-content: space-between; align-items: center; }
.ro-amount { font-size: 34rpx; color: var(--primary); font-weight: bold; }
.ro-actions { display: flex; gap: 12rpx; }

.ro-btn {
  font-size: 22rpx !important;
  padding: 0 20rpx !important;
  height: 48rpx !important;
  line-height: 48rpx !important;
}

.empty-state { text-align: center; padding: 120rpx 0; }
.empty-icon { font-size: 100rpx; opacity: 0.3; display: block; }
.empty-text { font-size: 28rpx; color: var(--text-placeholder); margin-top: 16rpx; display: block; }
